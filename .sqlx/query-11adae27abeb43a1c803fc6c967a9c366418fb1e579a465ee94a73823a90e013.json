  "query": "select b.id, b.nom, b.couleur, b.actif, b.ordre,\n                  (select count(*) from fut f where f.type_biere_id = b.id) as \"futs!\"\n             from type_biere b\n            where (not $1 or b.actif)\n            order by b.ordre, b.nom",
