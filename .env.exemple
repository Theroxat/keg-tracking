# Copier en .env et remplir. Aucune valeur par défaut n'existe : l'application
# refuse de démarrer si l'une de ces variables manque.
#
#   gen() { head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 32; }

POSTGRES_PASSWORD=
MDP_OWNER=
MDP_APP=
MDP_EDITEUR=
MDP_AUTH=

# Poivre du hachage Argon2id : au moins 32 caractères.
# Le changer invalide tous les mots de passe et tous les codes PIN.
SECRET_APP=

DOMAINE_PUBLIC=qr.exemple.fr
PORT_PUBLIC=6666
FUSEAU_DEFAUT=Europe/Paris
RUST_LOG=info

# Rétention des sauvegardes.
RETENTION_QUOTIDIENNE=7
RETENTION_HEBDOMADAIRE=4
RETENTION_MENSUELLE=6
